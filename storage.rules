rules_version = '2';

// =============================================================================
// Pushkaralu — Storage Security Rules
//
// Layout convention: images/{entityType}/{entityId}/{filename}
// e.g. images/ghats/ghat-abc123/hero.jpg
//
// Same role source of truth as firestore.rules: request.auth.token.role,
// a server-set custom claim — never trust anything else.
// =============================================================================

function isSignedIn() {
  return request.auth != null;
}

function role() {
  return isSignedIn() ? request.auth.token.role : null;
}

function isStaff() {
  return role() in ['EDITOR', 'MODERATOR', 'ADMIN', 'SUPER_ADMIN'];
}

function isReasonableImage() {
  return request.resource.size < 8 * 1024 * 1024 // 8MB cap
    && request.resource.contentType.matches('image/.*');
}

service firebase.storage {
  match /b/{bucket}/o {

    // Content images (events, ghats, temples) — admin-managed content,
    // public read (they're displayed on public pages), staff-only write.
    match /images/{entityType}/{entityId}/{fileName} {
      allow read: if true;
      allow write: if isStaff() && isReasonableImage();
      allow delete: if isStaff();
    }

    // Provider-owned listing images (hotels, purohits, businesses) —
    // Sprint 4. Staff can always manage them (moderation); the listing's
    // own owner can too, verified via a cross-service Firestore read
    // against that collection's ownership field. Public read, since
    // these are displayed on public detail pages once approved (an
    // unapproved listing's images aren't linked from anywhere public,
    // but are technically fetchable by direct URL — acceptable, matches
    // the same document-vs-UI privacy tradeoff noted in
    // features/hotels/types.ts).
    match /images/hotels/{hotelId}/{fileName} {
      allow read: if true;
      allow write: if isReasonableImage() && (isStaff() ||
        (isSignedIn() && firestore.get(/databases/(default)/documents/hotels/$(hotelId)).data.ownerId == request.auth.uid));
      allow delete: if isStaff() ||
        (isSignedIn() && firestore.get(/databases/(default)/documents/hotels/$(hotelId)).data.ownerId == request.auth.uid);
    }
    match /images/purohits/{purohitId}/{fileName} {
      allow read: if true;
      allow write: if isReasonableImage() && (isStaff() ||
        (isSignedIn() && firestore.get(/databases/(default)/documents/purohits/$(purohitId)).data.userId == request.auth.uid));
      allow delete: if isStaff() ||
        (isSignedIn() && firestore.get(/databases/(default)/documents/purohits/$(purohitId)).data.userId == request.auth.uid);
    }
    match /images/businesses/{businessId}/{fileName} {
      allow read: if true;
      allow write: if isReasonableImage() && (isStaff() ||
        (isSignedIn() && firestore.get(/databases/(default)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid));
      allow delete: if isStaff() ||
        (isSignedIn() && firestore.get(/databases/(default)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid);
    }

    // Default deny for anything not explicitly matched above.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
